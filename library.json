{
  "name": "uicons",
  "version": "0.1.0",
  "description": "Embedded icons with selectable catalogs, sizes, and display formats",
  "keywords": ["icons", "embedded", "platformio", "bitmap", "u8g2"],
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyputi/uicons.git"
  },
  "authors": [
    {
      "name": "nomadnt-iot"
    }
  ],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "headers": ["uicons.h", "fontawesome.h"],
  "build": {
    "includeDir": "src"
  },
  "export": {
    "exclude": [
      "assets/*",
      "scripts/*",
      "tools/*",
      "tests/*",
      "examples/*.json",
      "build/*",
      ".*"
    ]
  }
}
